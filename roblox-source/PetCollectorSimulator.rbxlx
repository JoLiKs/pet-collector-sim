		Description = "+10 pet storage per level.",
		MaxLevel = 10,
		Currency = "Coins",
		BaseCost = 300,
		Growth = 1.9,
	},
	{
		Id = "Slots",
		Name = "Pet Slot",
		Description = "+1 equipped pet slot.",
		MaxLevel = 4,
		Currency = "Gems",
		BaseCost = 0,
		Growth = 1,
		Costs = { 100, 300, 800, 2000 },
	},
} :: { UpgradeDef }

UpgradeData.ById = {} :: { [string]: UpgradeDef }
for _, def in ipairs(UpgradeData.List) do
	UpgradeData.ById[def.Id] = def
end

return UpgradeData
]]></ProtectedString>
