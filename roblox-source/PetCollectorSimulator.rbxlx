}

local UpgradeData = {}

UpgradeData.CLICK_PER_LEVEL = 1
UpgradeData.SPEED_PER_LEVEL = 1.5
UpgradeData.LUCK_PER_LEVEL = 0.03
UpgradeData.BAG_PER_LEVEL = 10

UpgradeData.List = {
	{
		Id = "Click",
