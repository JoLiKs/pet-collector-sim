)
EnemyData.RAID_BASE_HP = 12000
EnemyData.RAID_HP_PER_PLAYER = 0.6 -- +60% здоровья за каждого дополнительного игрока
-- Лунные существа (появляются в зонах во время «Лунной ночи»)
EnemyData.MOONLING = e(
	"moonling",
	"Moonling",
	"Any",
	false,
	3,
	0.8,
	3,
	c3(210, 220, 255),
	c3(90, 60, 200),
	"Ball",
	1.1,
	30,
