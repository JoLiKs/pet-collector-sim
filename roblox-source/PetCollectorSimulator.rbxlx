} :: { ZoneDef }

ZoneData.ById = {} :: { [string]: ZoneDef }
ZoneData.Index = {} :: { [string]: number }
for i, zone in ipairs(ZoneData.List) do
	ZoneData.ById[zone.Id] = zone
	ZoneData.Index[zone.Id] = i
end

