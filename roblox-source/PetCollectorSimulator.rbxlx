		UnlockCost = 100000,
		RequiresRebirths = 0,
		Position = Vector3.new(800, 0, 0),
		Floor = Color3.fromRGB(231, 200, 129),
		Accent = Color3.fromRGB(86, 160, 80),
		Material = Enum.Material.Sand,
		Sky = Color3.fromRGB(255, 220, 160),
